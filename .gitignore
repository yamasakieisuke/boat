# Secrets
.env
.env.*
!.env.example

# Generated / Data
data/*
output/
inbox/
logs/
*.log

# Exception: WP plugin bundle accuracy mirror (deployed to heteml via Actions)
!wordpress/boat-forecast-viewer/data/
!wordpress/boat-forecast-viewer/data/**

# Exception: fetch_pending.yml が読む依頼ファイル（predict.yml watchlist が書き込む）
!data/fetch_requests.json

# Exception: verify の蓄積ログ（P0-1）
# Actions の runner は毎回まっさらなので、これを git に載せないと精度の履歴が
# 一切積み上がらない（日次verifyは走っているのに結果が毎日捨てられていた）。
# data/logs/ 自体は pred.json で膨らむため、この1ファイルだけを例外にする。
!data/logs/
data/logs/*
!data/logs/verify_history.json

# Exception: 予想に必要な統計データ（verify.yml が build_stats.py で更新→commit）
# - results_csv: build_stats.py の入力ソース（過去レース結果）
# - players: 選手の枠別着順実績ほか（predictor が直接読む）
# - motors: モーター成績（predictor が直接読む）
!data/results_csv/
!data/results_csv/**
!data/players/
!data/players/**
!data/motors/
!data/motors/**

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local overrides
.claude/settings.local.json
